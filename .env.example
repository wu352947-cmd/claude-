# ---- 基础 ----
PORT=8080
# 数据目录：SQLite 数据库与用户照片都在这里，请定期备份
DATA_DIR=/data
# Cookie 是否只走 HTTPS：auto（按请求判断，需反代传 X-Forwarded-Proto）| true | false
COOKIE_SECURE=auto
# 页脚显示的 ICP 备案号，例如：浙ICP备2026000000号-1
SITE_ICP=

# ---- AI 回信（不填则关闭）----
# 国内推荐使用已完成生成式 AI 服务备案的模型：
#   deepseek  → https://api.deepseek.com            默认模型 deepseek-chat
#   qwen      → 阿里云百炼 DashScope 兼容模式         默认模型 qwen-plus
#   openai-compatible → 其他兼容 OpenAI 协议的服务，需同时填写 AI_BASE_URL 与 AI_MODEL
#   anthropic → Claude（不对中国大陆提供服务，仅供海外部署；需 npm i @anthropic-ai/sdk，并设置 ANTHROPIC_API_KEY）
#   mock      → 本地演示用模板信
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# 每位用户每天最多几封回信
AI_DAILY_LIMIT=3
# 每个 IP 每小时最多注册几次
REGISTER_LIMIT_PER_HOUR=10

# ---- 手机号验证码登录（不填则只能用户名密码登录）----
# aliyun：阿里云短信服务。需在控制台申请短信签名与“验证码”模板，模板变量名为 code
SMS_PROVIDER=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
# 验证码哈希密钥（不填则首次启动时自动生成并保存在 DATA_DIR/secret.key）
APP_SECRET=

# ---- 实时天气（不填则关闭）----
# 用户在设置里选城市后，背景会下起当地的雨雪、飘起雾和云。只向服务商发送城市坐标
#   qweather    → 和风天气（国内服务）：控制台创建项目与 API KEY，并填写控制台“设置”里显示的专属 API Host
#   open-meteo  → 免密钥，服务器在境外
WEATHER_PROVIDER=
QWEATHER_KEY=
QWEATHER_HOST=

# ---- 灯海（匿名心愿灯）的审核 ----
# 面向公众的用户内容必须有审核能力。强烈建议接入机器审核，并安排人巡查 /admin.html
#   aliyun → 阿里云内容安全“文本审核增强版”（复用上面的 ALIYUN_ACCESS_KEY_ID / SECRET，需在控制台开通并授权 RAM 子账号）
MODERATION_PROVIDER=
ALIYUN_GREEN_REGION=cn-shanghai
# 未接机器审核时：pre = 先审后发（默认），post = 先发后审
LANTERN_REVIEW=pre
LANTERN_DAILY_LIMIT=3
# 审核页 /admin.html 的口令（足够长的随机串，例如 openssl rand -hex 24）；不填则审核入口关闭
ADMIN_TOKEN=

# ---- 内容加密 ----
# 手帐正文与信件以 AES-256-GCM 加密存储。生成方式：openssl rand -hex 32
# 不填则首次启动时生成并保存在 DATA_DIR/entry.key。请把密钥与数据分开备份：丢了密钥，内容就无法解密
ENTRY_KEY=
